{
  "name": "dsh-cron-jobs",
  "version": "0.1.0",
  "description": "Cron-scheduled shell commands for DeepSeek Harness, with an optional gate that wakes an agent only when there is something to do.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "check": "for f in index.js src/*.js test/*.js; do node --check \"$f\" || exit 1; done"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5",
    "croner": "^10.0.1",
    "zod": "^4.6.7"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "cron",
    "scheduler"
  ],
  "author": "Sakina",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soffits/dsh-cron-jobs.git"
  },
  "homepage": "https://github.com/soffits/dsh-cron-jobs#readme",
  "bugs": {
    "url": "https://github.com/soffits/dsh-cron-jobs/issues"
  }
}
