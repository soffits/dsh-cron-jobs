{
  "name": "@soffits/dsh-cron-jobs",
  "version": "0.6.0",
  "description": "Scheduled jobs for DeepSeek Harness: shell commands and agent prompts on cron, RRULE or one-time schedules, a gate that wakes an agent only when there is something to do, result delivery through any plugin that can send messages, tools to manage jobs from a conversation, and a Cron tasks page in the Web GUI.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./tools": "./tools.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "tools.js",
    "client.js",
    "src/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "check": "for f in index.js tools.js client.js src/*.js test/*.js; do node --check \"$f\" || exit 1; done"
  },
  "dependencies": {
    "@deepseek-ai/dsh-util-time": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.5",
    "croner": "^11.0.0",
    "zod": "^4.6.7"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "cron",
    "scheduler"
  ],
  "author": "Sakina",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soffits/dsh-cron-jobs.git"
  },
  "homepage": "https://github.com/soffits/dsh-cron-jobs#readme",
  "bugs": {
    "url": "https://github.com/soffits/dsh-cron-jobs/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-storage": "0.2.2-rc.1",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.1",
    "@deepseek-ai/dsh-storage-json": "0.2.2-rc.1",
    "@deepseek-ai/dsh-workspace": "0.2.2-rc.1"
  }
}
